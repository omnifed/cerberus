{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "coverage",
    ".husky",
    "pnpm-lock.yaml",
    "packages/*/dist",
    "packages/*/build",
    "tests/codegen/fixtures",
    "docs/generated/api-specs/*.md"
  ],
  "printWidth": 80,
  "semi": false,
  "singleQuote": true
}
