{
  "name": "cerberus",
  "version": "0.0.0",
  "description": "The official design system factory for Omnifederal.",
  "license": "ISC",
  "author": "developers@omnifederal.com",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint:es": "eslint . --max-warnings=0",
    "lint:ox": "oxlint --deny-warnings",
    "lint:npmPackages": "pnpm --filter @cerberus-design/* run -w lint:ts",
    "lint:jsrPackages": "pnpm --filter @cerberus/* run -w lint:ts",
    "lint:tests": "pnpm --filter tests run lint:ts",
    "lint": "pnpm lint:npmPackages && pnpm lint:jsrPackages && pnpm lint:tests",
    "test": "pnpm --filter tests run test",
    "ci:version": "changeset version && bun ./scripts/src/bump-versions.mjs --stable && pnpm install --no-frozen-lockfile",
    "gen:component": "bun ./scripts/src/bootstrap-component.ts",
    "start:docs": "pnpm --filter docs run dev",
    "watch:react": "pnpm --filter @cerberus-design/react run -w watch",
    "watch:data-grid": "pnpm --filter @cerberus-design/data-grid run -w watch",
    "watch:ds": "pnpm watch:data-grid"
  },
  "dependencies": {
    "typescript": "catalog:ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "catalog:types",
    "@types/mdx": "^2.0.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "catalog:oxc",
    "oxlint": "^1.90.0"
  },
  "lint-staged": {
    "**/*": "oxfmt --write --no-error-on-unmatched-pattern",
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": "oxlint --fix"
  },
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
