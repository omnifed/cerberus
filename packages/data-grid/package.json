{
  "name": "@cerberus-design/data-grid",
  "version": "1.9.0",
  "description": "The Cerberus Design React DataGrid component.",
  "keywords": [
    "data grid",
    "data grid component",
    "pandacss",
    "react",
    "react signals",
    "react signals component"
  ],
  "license": "ISC",
  "author": "developers@omnifederal.com",
  "repository": {
    "url": "https://github.com/omnifed/cerberus"
  },
  "files": [
    "dist",
    "src",
    "styled-system",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "module": "src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./panda/*": "./dist/panda/*",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.js"
    },
    "./css/*": {
      "types": "./styled-system/css/*.d.ts",
      "default": "./styled-system/css/*.js"
    },
    "./recipes": {
      "types": "./styled-system/recipes/index.d.ts",
      "default": "./styled-system/recipes/index.js"
    },
    "./recipes/*": {
      "types": "./styled-system/recipes/*.d.ts",
      "default": "./styled-system/recipes/*.js"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./styled-system/patterns/*.d.ts",
      "default": "./styled-system/patterns/*.js"
    },
    "./jsx": {
      "types": "./styled-system/jsx/index.d.ts",
      "default": "./styled-system/jsx/index.js"
    },
    "./jsx/*": {
      "types": "./styled-system/jsx/*.d.ts",
      "default": "./styled-system/jsx/*.js"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.js"
    },
    "./helpers": {
      "types": "./styled-system/helpers.d.ts",
      "default": "./styled-system/helpers.js"
    },
    "./types": {
      "types": "./styled-system/types/index.d.ts"
    }
  },
  "publishConfig": {
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.cts",
    "typesVersions": {
      "*": {
        ".": [
          "dist/index.d.cts"
        ]
      }
    },
    "access": "public"
  },
  "scripts": {
    "generate": "panda codegen && panda lib",
    "prepublishOnly": "pnpm generate",
    "lib": "pnpm generate",
    "watch": "pnpm generate --watch",
    "clean": "rm -rf ./dist",
    "build": "vite build && pnpm lib",
    "lint:ts": "tsc --project tsconfig.lint.json --noEmit"
  },
  "dependencies": {
    "@cerberus-design/react": "workspace:*",
    "@cerberus-design/signals": "workspace:*"
  },
  "devDependencies": {
    "@cerberus/panda-preset": "workspace:*",
    "@pandacss/dev": "catalog:pandacss",
    "@pandacss/types": "catalog:pandacss",
    "@types/react": "catalog:jsx",
    "@types/react-dom": "catalog:jsx",
    "@typescript/typescript6": "catalog:jsx",
    "@vitejs/plugin-react": "catalog:jsx",
    "globby": "catalog:jsx",
    "react": "catalog:jsx",
    "react-dom": "catalog:jsx",
    "styled-system": "workspace:*",
    "vite": "catalog:jsx",
    "vite-plugin-dts": "catalog:jsx"
  },
  "peerDependencies": {
    "@pandacss/dev": "*",
    "react": "*",
    "react-dom": "*"
  },
  "browserslist": "> 0.25%, not dead"
}
