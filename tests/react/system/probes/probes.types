/**
 * THROWAWAY PROBES (types).
 *
 * `bun test` does NOT typecheck, so run:   bunx tsc --noEmit
 * and read only the errors that point at this file.
 *
 * How to read the result:
 * - A plain type error here means my expectation was wrong or the type is broken.
 * - "Unused '@ts-expect-error' directive" means the line I expected to be
 *   rejected was ACCEPTED. That message is the finding.
 *
 * Adjust the `cerberus` import path to match v2-factory_test.tsx.
 */
import { Accordion as Ark } from '@ark-ui/react/accordion'
import { cerberus } from '@cerberus-design/react'
import { createRef, type ComponentProps } from 'react'
import { cva, sva } from 'styled-system/css'
import {
  createSlotRecipeContext,
  type ComponentProps as PandaComponentProps,
} from 'styled-system/jsx'

const accordion = sva({
  slots: ['root', 'item'],
  base: { root: { display: 'flex' }, item: { borderWidth: '1px' } },
  variants: {
    size: {
      sm: { item: { p: '1' } },
      lg: { item: { p: '4' } },
    },
  },
  defaultVariants: { size: 'lg' },
})

const { withProvider, withContext } = createSlotRecipeContext(accordion)
const Root = withProvider(Ark.Root, 'root')
const Item = withContext(Ark.Item, 'item')

// T1. Recipe variants appear in BOTH flavors of ComponentProps
//     (React's, and the Panda one your primitives.tsx uses).
export const t1a: ComponentProps<typeof Root> = { size: 'sm' }
export const t1b: PandaComponentProps<typeof Root> = { size: 'sm' }

// @ts-expect-error an unknown variant value must be rejected on Root
export const t1c: ComponentProps<typeof Root> = { size: 'xl' }

// T2. asChild, style props and css are accepted on a part.
export const T2 = () => (
  <Root>
    <Item value="a" asChild>
      <section />
    </Item>
    <Item value="b" color="red" css={{ p: '2' }} />
  </Root>
)

// T3. Decision 5: parts do not accept variant props.
//     `size` is also a Panda style prop. If this line is accepted, a user
//     who passes size="sm" to a part gets no error (see runtime probe P3).
export const T3 = () => (
  <Root>
    {/* @ts-expect-error decision 5: parts do not accept variant props */}
    <Item value="a" size="sm" />
  </Root>
)

// T4. Decision 3: slot recipes are not accepted by cerberus().
// @ts-expect-error a slot recipe must be rejected
export const T4 = cerberus('div', accordion)

// T5. A cva recipe's variants become typed props; ref is a normal prop.
const badge = cva({
  base: { px: '2' },
  variants: { tone: { info: { color: 'blue' }, danger: { color: 'red' } } },
})
const Badge = cerberus('span', badge)

export const T5 = () => (
  <>
    <Badge tone="info" />
    {/* @ts-expect-error an unknown variant value must be rejected */}
    <Badge tone="nope" />
    <cerberus.button ref={createRef<HTMLButtonElement>()} asChild>
      <a href="/x">x</a>
    </cerberus.button>
  </>
)
